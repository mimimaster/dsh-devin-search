{
  "name": "pi-devin-search",
  "version": "0.1.0",
  "description": "Native pi CLI extension for Devin web and local code search",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "pi": { "extensions": ["./dist/extension.js"] },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ignore": "7.0.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
